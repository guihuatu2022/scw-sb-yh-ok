{
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-ws-in",
      "listen": "0.0.0.0",
      "listen_port": 8080,
      "sniff": false,
      "users": [
        { "uuid": "@UUID@", "flow": "" }
      ],
      "transport": {
        "type": "ws",
        "path": "@WS_PATH@",
        "max_early_data": 2048,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      },
      "multiplex": { "enabled": true, "padding": false }
    }
  ],
  ...
}
